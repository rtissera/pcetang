+/* PCE PORT (2026-09-18): golden-trace instrumentation for the SuperGrafx defect hunt.
+   Gated entirely on the PCE_VGOLD_LOG environment variable, so an unset build behaves
+   exactly as before. Emits the same fields as golden/sgx_vgold.lua does out of MAME, so
+   the two independent references can be diffed line for line -- neither is trusted alone.
+   Frame numbers are mandatory: without them a late write reads like an init write, which
+   has already caused one wrong root-cause call on this project. */
+#include <stdlib.h>
+static FILE *pce_vgold_fp = NULL;
+static int pce_vgold_open = 0;
+uint32 pce_vgold_frames = 0;
+static FILE *pce_vgold(void)
+{
+   if (!pce_vgold_open)
+   {
+      const char *path = getenv("PCE_VGOLD_LOG");
+      pce_vgold_open = 1;
+      if (path && *path)
+         pce_vgold_fp = fopen(path, "w");
+   }
+   return pce_vgold_fp;
+}
+static void pce_vgold_log(const char *blk, uint32 A, uint8 V)
+{
+   FILE *f = pce_vgold();
+   if (f)
+   {
+      fprintf(f, "%u W %s %06X %02X\n", (unsigned)pce_vgold_frames, blk, (unsigned)A, V);
+      fflush(f);
+   }
+}
+
