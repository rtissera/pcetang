+/* GOLDEN TRACE PROBE (scratch build, 2026-09-14): every VCE control-register write and
+   every VDC MWR (reg $09) write. Hardware tag 0xB3 on the Tang board showed the VCE CR
+   ending at 0xFF after exactly one write from Double Dragon 2's own code -- DOTCLOCK=512
+   and BW=1 -- while the VDC's BAT size never left 32x32. No real game writes 0xFF to
+   $0400, so this says whether the reference emulator does the same thing. */
+#include <stdio.h>
+#include <stdlib.h>
+static FILE *pce_vgold(void)
+{
+   static FILE *f = NULL;
+   static int tried = 0;
+   if (!tried) {
+      const char *p = getenv("PCE_VGOLD_LOG");
+      tried = 1;
+      if (p && *p) f = fopen(p, "w");
+   }
+   return f;
+}
