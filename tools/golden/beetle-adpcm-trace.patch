+/* GOLDEN CD-REGISTER TRACE (scratch build 2026-09-14): every $1800-$180F access, so the
+   reference's command sequence can be diffed against the board's. Separate env var and
+   file from the VCE/VDC trace in vdc.c so the two do not interleave. */
+#include <stdio.h>
+#include <stdlib.h>
+static FILE *pce_cdlog(void)
+{
+   static FILE *f = NULL; static int tried = 0;
+   if (!tried) { const char *p = getenv("PCE_CDREG_LOG"); tried = 1; if (p && *p) f = fopen(p, "w"); }
+   return f;
+}
+static unsigned long pce_cdreg_n = 0;
+/* ---------------------------------------------------------------------------------------
+ * ADPCM golden trace (pcetang, 2026-09-17). Enabled only when PCE_ADPCM_LOG=<prefix> is set.
+ *   <prefix>.log          text: register writes $1808-$180F, play start/stop, with frame no.
+ *   <prefix>_writes.bin   8-byte records: u32 frame, u16 byte addr, u8 value, u8 src (0 CPU $180A, 1 DMA)
+ *   <prefix>_ram_<n>.bin  65536-byte ADPCM RAM image at the n-th playback start
+ *   <prefix>_nib.bin      one byte per nibble actually fed to the OKI decoder, in play order
+ * RAM here is BYTES; the FPGA stores one nibble per address, byte k -> nibbles 2k (high), 2k+1.
+ * ------------------------------------------------------------------------------------- */
+extern unsigned long pce_vgold_frames;
+static const char *pce_adpcm_prefix(void)
+{
+   static const char *p = NULL; static int tried = 0;
+   if (!tried) { tried = 1; p = getenv("PCE_ADPCM_LOG"); if (p && !*p) p = NULL; }
+   return p;
+}
+static FILE *pce_adpcm_open(const char *suffix)
+{
+   char path[1024];
+   snprintf(path, sizeof(path), "%s%s", pce_adpcm_prefix(), suffix);
+   return fopen(path, "wb");
+}
+static FILE *pce_adpcm_txt(void)
+{ static FILE *f = NULL; static int t = 0; if (!t && pce_adpcm_prefix()) { t = 1; f = pce_adpcm_open(".log"); } return f; }
+static FILE *pce_adpcm_wr(void)
+{ static FILE *f = NULL; static int t = 0; if (!t && pce_adpcm_prefix()) { t = 1; f = pce_adpcm_open("_writes.bin"); } return f; }
+static FILE *pce_adpcm_nib(void)
+{ static FILE *f = NULL; static int t = 0; if (!t && pce_adpcm_prefix()) { t = 1; f = pce_adpcm_open("_nib.bin"); } return f; }
+/* <prefix>_pcm.bin: int16 LE per decoded nibble = OKIADPCM_Decode() - 2048, before fade/LPF */
+static FILE *pce_adpcm_pcm(void)
+{ static FILE *f = NULL; static int t = 0; if (!t && pce_adpcm_prefix()) { t = 1; f = pce_adpcm_open("_pcm.bin"); } return f; }
+static uint8 pce_adpcm_wsrc = 0;
+static unsigned long pce_adpcm_plays = 0, pce_adpcm_nibs = 0;
+
