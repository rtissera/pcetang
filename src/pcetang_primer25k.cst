// Tang Primer 25K pins for pcetang. clk/key_reset_n/SDRAM pins reused unchanged from
// NECTang's own real, gw_sh-verified core_test.cst (src/boards/tang_primer25k/
// core_test.cst there). HDMI/UART pins reused directly from nand2mario's own nestang
// primer25k.cst (github.com/nand2mario/nestang, his own board, his own working
// config) -- higher confidence than Console 60K's cross-protocol guess, still not
// hardware-verified here.

IO_LOC  "clk" E2;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;

IO_LOC  "key_reset_n" H11;
IO_PORT "key_reset_n" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=OFF BANK_VCCIO=3.3;

// SDRAM
IO_LOC "IO_sdram_dq[0]" K2;
IO_PORT "IO_sdram_dq[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "IO_sdram_dq[1]" K1;
IO_PORT "IO_sdram_dq[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "IO_sdram_dq[2]" L1;
IO_PORT "IO_sdram_dq[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
