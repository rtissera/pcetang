// 2026-09-07: DQ pins moved PULL_MODE=NONE -> DOWN. Real hardware read-back of the ROM
// image, with the SDRAM interface otherwise proven clean (pattern self-test 0/256, write
// bridge drops 0), still showed 8 of 128 bytes wrong -- and every one of them was the
// CORRECT byte with only low bits SET, never cleared, always at an odd address:
//   0x19 e3->ef  0x23 c2->cf  0x3f 00->03  0x4b 85->87
//   0x4f 64->67  0x5d a9->ab  0x7f 03->0f
// Odd address = high byte lane, and bits 0-3 there are DQ[8],[9],[10],[11] -- four
// adjacent pins (B21/A21/B20/A20). Correct-value-plus-set-bits rules out stale data
// (that would be arbitrary); this is those lines failing to pull DOWN in time. A weak
// pull-down assists exactly the 1->0 direction that is failing. If this does not help,
// the next lever is the read capture phase, NOT more clock reduction.

// Tang Console 60K pins for pcetang. clk/key_reset_n/leds_n and the HDMI TMDS pins are
// real, cross-checked against ../TangNano60K's own Console 60K constraint file
// (zxnext_console60k.cst, hardware-proven on this same board for a different core) --
// P/N pin pairs there use Gowin's combined "one name, two IO_LOC" differential
// shorthand; this file's RTL uses explicit separate tmds_*_p/tmds_*_n ports (matching
// nand2mario's nes2hdmi.sv ELVDS_OBUF style, which this repo's pce2hdmi.sv follows), so
// the pairs are split into separate IO_LOC lines here, values unchanged.
//
// uart_rxd/uart_txd real pins: V14/U15 (2026-09-01), confirmed against
// ../../tangcore-work/tangcore/monitor/src/boards/console.cst -- hardware-proven on
// this exact board via monitor.bin's own working BL616 CORE_ID handshake. The prior
// guess (R13/U13, the JTAG TDI/TDO pins) was real but wrong: it made this design's own
// UART driver fight BL616's own bit-banged JTAG signals on the same wires the instant
// the core went active, corrupting the tail of every SRAM-load transaction over BL616's
// own JTAG path (external JTAG cables use a separate header, so they never saw it). See
// the uart_txd/uart_rxd IO_LOC block below.

IO_LOC  "clk" V22;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF;

IO_LOC  "key_reset_n" AA13;
IO_PORT "key_reset_n" IO_TYPE=LVCMOS15 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=1.5;

// SDRAM -- real pins from nand2mario's nestang/src/boards/console.cst (same physical
// Tang SDRAM V1.3 PMOD module Primer 25K uses; no CKE pin wired on either board's real
// .cst despite the port existing on sdram.sv). Style (IO_TYPE/PULL_MODE only, no
// DRIVE/BANK_VCCIO) matches pcetang_primer25k.cst's own SDRAM block for consistency.
IO_LOC  "IO_sdram_dq[0]" E14;
IO_PORT "IO_sdram_dq[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "IO_sdram_dq[1]" E13;
IO_PORT "IO_sdram_dq[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "IO_sdram_dq[2]" C15;
IO_PORT "IO_sdram_dq[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "IO_sdram_dq[3]" C14;
IO_PORT "IO_sdram_dq[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "IO_sdram_dq[4]" B13;
IO_PORT "IO_sdram_dq[4]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "IO_sdram_dq[5]" C13;
IO_PORT "IO_sdram_dq[5]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "IO_sdram_dq[6]" A14;
IO_PORT "IO_sdram_dq[6]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "IO_sdram_dq[7]" A13;
IO_PORT "IO_sdram_dq[7]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "IO_sdram_dq[8]" B21;
IO_PORT "IO_sdram_dq[8]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "IO_sdram_dq[9]" A21;
IO_PORT "IO_sdram_dq[9]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "IO_sdram_dq[10]" B20;
IO_PORT "IO_sdram_dq[10]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "IO_sdram_dq[11]" A20;
IO_PORT "IO_sdram_dq[11]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "IO_sdram_dq[12]" A15;
IO_PORT "IO_sdram_dq[12]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "IO_sdram_dq[13]" A16;
IO_PORT "IO_sdram_dq[13]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "IO_sdram_dq[14]" B15;
IO_PORT "IO_sdram_dq[14]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "IO_sdram_dq[15]" B16;
IO_PORT "IO_sdram_dq[15]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "O_sdram_addr[0]" D19;
IO_PORT "O_sdram_addr[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "O_sdram_addr[1]" E19;
IO_PORT "O_sdram_addr[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "O_sdram_addr[2]" C19;
IO_PORT "O_sdram_addr[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "O_sdram_addr[3]" C18;
IO_PORT "O_sdram_addr[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "O_sdram_addr[4]" E16;
IO_PORT "O_sdram_addr[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "O_sdram_addr[5]" D15;
IO_PORT "O_sdram_addr[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "O_sdram_addr[6]" D14;
IO_PORT "O_sdram_addr[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "O_sdram_addr[7]" A19;
IO_PORT "O_sdram_addr[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "O_sdram_addr[8]" A18;
IO_PORT "O_sdram_addr[8]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "O_sdram_addr[9]" C17;
IO_PORT "O_sdram_addr[9]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "O_sdram_addr[10]" D20;
IO_PORT "O_sdram_addr[10]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "O_sdram_addr[11]" D17;
IO_PORT "O_sdram_addr[11]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "O_sdram_addr[12]" B18;
IO_PORT "O_sdram_addr[12]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC  "O_sdram_ba[0]" F15;
IO_PORT "O_sdram_ba[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "O_sdram_ba[1]" C20;
IO_PORT "O_sdram_ba[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC  "O_sdram_dqm[0]" F14;
IO_PORT "O_sdram_dqm[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "O_sdram_dqm[1]" F13;
IO_PORT "O_sdram_dqm[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC  "O_sdram_clk" B17;
IO_PORT "O_sdram_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "O_sdram_wen_n" D16;
IO_PORT "O_sdram_wen_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "O_sdram_ras_n" F16;
IO_PORT "O_sdram_ras_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "O_sdram_cas_n" E17;
IO_PORT "O_sdram_cas_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "O_sdram_cs_n" F21;      // was F19 on mega60k
IO_PORT "O_sdram_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC  "leds_n[0]" G11;
IO_PORT "leds_n[0]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "leds_n[1]" U12;
IO_PORT "leds_n[1]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE BANK_VCCIO=3.3;

// HDMI TMDS -- real pins, cross-checked against ../TangNano60K's zxnext_console60k.cst
// (tmds_clk_p "G15,G16" there = P,N in that order; same for tmds_d_p[0..2]).
IO_LOC  "tmds_clk_p" G15;
IO_PORT "tmds_clk_p" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33D;
IO_LOC  "tmds_clk_n" G16;
IO_PORT "tmds_clk_n" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33D;
IO_LOC  "tmds_d_p[0]" J14;
IO_PORT "tmds_d_p[0]" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33D;
IO_LOC  "tmds_d_n[0]" H14;
IO_PORT "tmds_d_n[0]" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33D;
IO_LOC  "tmds_d_p[1]" J15;
IO_PORT "tmds_d_p[1]" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33D;
IO_LOC  "tmds_d_n[1]" H15;
IO_PORT "tmds_d_n[1]" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33D;
IO_LOC  "tmds_d_p[2]" K17;
IO_PORT "tmds_d_p[2]" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33D;
IO_LOC  "tmds_d_n[2]" J17;
IO_PORT "tmds_d_n[2]" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33D;

// BL616 UART -- real pins (2026-09-01), cross-checked against
// ../../tangcore-work/tangcore/monitor/src/boards/console.cst, which is hardware-proven
// on this exact board (monitor.bin's own CORE_ID handshake works over these pins).
// The old R13/U13 guess put this UART on the JTAG TDI/TDO pins -- as soon as this
// design's own UART driver went live post-config it fought BL616's own bit-banged JTAG
// on the same wires, corrupting the tail of the SRAM-load transaction (readStatusReg
// coming back all-zero, DONE never seen) -- real, GHDL/gw_sh-clean bitstreams loaded
// fine, only BL616's own JTAG path broke. use_jtag_as_gpio is no longer needed either.
IO_LOC  "uart_txd" U15;
IO_PORT "uart_txd" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "uart_rxd" V14;
IO_PORT "uart_rxd" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;

// DS2 (PlayStation-style) pads on PMOD1, both players. Pins taken verbatim from
// tangcore monitor/src/boards/console.cst -- the monitor core reads these same pads for
// the TangCore menu, so these assignments are known-good on this hardware.
// ds_miso needs PULL_MODE=UP: it is the pad's open-drain data line.
IO_LOC  "ds_cs"    W19;   // PMOD1_IO0
IO_PORT "ds_cs"    PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "ds_mosi"  F19;   // PMOD1_IO2
IO_PORT "ds_mosi"  PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "ds_miso"  E22;   // PMOD1_IO4
IO_PORT "ds_miso"  PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC  "ds_clk"   E21;   // PMOD1_IO6
IO_PORT "ds_clk"   PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "ds_cs2"   W20;   // PMOD1_IO1
IO_PORT "ds_cs2"   PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "ds_mosi2" F20;   // PMOD1_IO3
IO_PORT "ds_mosi2" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "ds_miso2" D22;   // PMOD1_IO5
IO_PORT "ds_miso2" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC  "ds_clk2"  D21;   // PMOD1_IO7
IO_PORT "ds_clk2"  PULL_MODE=NONE IO_TYPE=LVCMOS33;
